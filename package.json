{
  "name": "@local/tree-conversations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Explore — a branching-conversation canvas for DeepSeek Harness: ask a follow-up on any answer and grow a new branch.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "branching",
    "conversation-canvas"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzzs/dsh-explore.git"
  },
  "homepage": "https://github.com/tzzs/dsh-explore#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
